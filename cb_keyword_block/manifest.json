{
  "manifest_version": 3,
  "name": "Page Keyword Filter",
  "version": "1.0.7",
  "description": "Blocks pages whose title or visible body text contains a blocked keyword.",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-keyword-filter-7f3a@local.addons",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["bg.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["block.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}

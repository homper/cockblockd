[Unit]
Description=cockblock BPF LSM signal blocker
DefaultDependencies=no
After=systemd-modules-load.service sysinit.target
Before=cockblock.service
Wants=systemd-modules-load.service
# bpffs must be mounted for the pin.
RequiresMountsFor=/sys/fs/bpf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/cockblock/bpf/cockblock_loader /opt/cockblock/bpf/cockblock_lsm.bpf.o
# Hardening for the loader itself (it is short-lived, runs once at boot).
NoNewPrivileges=no
ProtectSystem=strict
ReadWritePaths=/sys/fs/bpf
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
